{% extends 'base.html.twig' %}

{% block title %}{{ recette.fiche }}{% endblock %}

{% block body %}
{% set notes = recette.notes %}
{% set moyenne = notes|length > 0
    ? (notes|map(n => n.note)|reduce((total, v) => total + v, 0) / notes|length)
    : null %}

<div class="container my-5 text-light">

    <h1 class="mb-4">{{ recette.fiche }}</h1>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            {% for categorie in recette.categories %}
                <span class="badge bg-primary me-2">{{ categorie.description2 }}</span>
            {% else %}
                <span class="badge bg-secondary">Aucune catégorie</span>
            {% endfor %}
        </div>

        <span>Préparation : {{ recette.tempsPreparation ?? '—' }} min</span>
    </div>

    {% if recette.avatar2 %}
        <img src="{{ asset('images/' ~ recette.avatar2) }}"
             class="img-fluid rounded mb-4 w-100"
             alt="{{ recette.fiche }}">
    {% endif %}

    <div class="row mb-4">
        <div class="col-md-8 mb-3 mb-md-0">
            <div class="border border-primary p-4 rounded">
                {{ recette.description3|nl2br }}
            </div>
        </div>

        <div class="col-md-4">
            <h3>Ingrédients</h3>
            <ul class="mb-4">
                {% for ingredient in recette.ingredients %}
                    <li>{{ ingredient.description }}</li>
                {% else %}
                    <li>Aucun ingrédient</li>
                {% endfor %}
            </ul>

            <p>Cuisson : {{ recette.tempsCuisson ?? '—' }} min</p>

        <h2 class="h4 mb-3">Commentaires</h2>

    {% set commentaires = notes|filter(n => n.description1 is not empty) %}

    {% for note in commentaires %}
        <div class="border border-secondary rounded p-3 mb-3">
            <div class="text-warning mb-1" aria-label="{{ note.note }} sur 5">
                {% for i in 1..5 %}{{ i <= note.note ? '★' : '☆' }}{% endfor %}
                <span class="text-light ms-2">{{ note.note }}/5</span>
            </div>
            <p class="mb-0">{{ note.description1|nl2br }}</p>
        </div>
    {% else %}
        <p class="text-secondary">Aucun commentaire pour le moment.</p>
    {% endfor %}
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 align-items-start mt-4">
        <a class="btn btn-primary" href="{{ path('app_recette_index') }}">
            Retour à la liste des recettes
        </a>

        {% if is_granted('ROLE_MODERATOR') %}
            <a class="btn btn-info" href="{{ path('app_recette_edit', {id: recette.id}) }}">
                Modifier
            </a>
            {{ include('recette/_delete_form.html.twig', {recette: recette}) }}
        {% endif %}
    </div>

</div>
{% endblock %}