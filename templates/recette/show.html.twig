{% extends 'base.html.twig' %}

{% block title %}{{ recette.fiche }}{% endblock %}

{% block body %}

<div class="container my-5 text-light">

    <h1 class="mb-4">{{ recette.fiche }}</h1>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            {% for categorie in recette.categories %}
                <a class="badge bg-primary text-decoration-none me-2"
                   href="{{ path('app_ingredient_index') }}">
                    {{ categorie.description2 }}
                </a>
            {% else %}
                <span class="badge bg-secondary">Aucune catégorie</span>
            {% endfor %}
        </div>

        <span>Préparation : 120 minutes</span>
    </div>

    {% if recette.avatar2 %}
        <div class="card mb-4">
            <img src="{{ asset('images/' ~ recette.avatar2) }}"
                 class="card-img-top"
                 alt="{{ recette.fiche }}">
        </div>
    {% endif %}

    <div class="row mb-4">
        <div class="col-md-8">
            <div class="border border-primary p-4 rounded" style="white-space: pre-wrap;">
                {{ recette.description3|nl2br }}
            </div>
        </div>

        <div class="col-md-4">
            <p>Cuisson : 120 minutes</p>

            <h3>Notes</h3>
            <ul>
                {% for note in recette.notes %}
                    <li>{{ note.note }} / 5</li>
                {% else %}
                    <li>Aucune note</li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <h2>Commentaires</h2>

    <ul>
        {% for note in recette.notes %}
            <li>{{ note.description1 }}</li>
        {% else %}
            <li>Aucun commentaire</li>
        {% endfor %}
    </ul>

    <a class="btn btn-primary" href="{{ path('app_recette_index') }}">
        Retour vers l'accueil
    </a>

    {% if is_granted('ROLE_MODERATOR') %}
        <a class="btn btn-info" href="{{ path('app_recette_edit', {'id': recette.id}) }}">
            Modifier
        </a>

        {{ include('recette/_delete_form.html.twig', { recette: recette }) }}
    {% endif %}

</div>

{% endblock %}