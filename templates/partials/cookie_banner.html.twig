{# templates/partials/cookie_banner.html.twig #}
<div id="cookie-banner"
     class="position-fixed bottom-0 start-0 end-0 bg-dark text-white p-3 shadow-lg d-none"
     style="z-index: 1080;"
     role="dialog" aria-live="polite" aria-labelledby="cookie-banner-title">
    <div class="container d-flex flex-column flex-md-row align-items-md-center gap-3">
        <div class="flex-grow-1">
            <p id="cookie-banner-title" class="fw-bold mb-1">🍪 Cookies sur Bravo Cuistot</p>
            <p class="mb-0 small">
                Nous utilisons des cookies de mesure d'audience (Google Tag Manager) pour améliorer le site.
                Ils ne sont déposés qu'avec votre accord. Vous pouvez changer d'avis à tout moment.
                {# Adapter la route vers la page de politique de confidentialité #}
                <a href="{{ path('app_privacy') }}" class="link-light">En savoir plus</a>
            </p>
        </div>
        {# CNIL : refuser doit être aussi simple et visible qu'accepter #}
        <div class="d-flex gap-2 flex-shrink-0">
            <button type="button" id="cookie-refuse" class="btn btn-outline-light">Tout refuser</button>
            <button type="button" id="cookie-accept" class="btn btn-light">Tout accepter</button>
        </div>
    </div>
</div>

<script>
(function () {
    var KEY = 'cookie_consent';
    var KEY_DATE = 'cookie_consent_date';
    var MAX_AGE = 1000 * 60 * 60 * 24 * 180; // choix conservé 6 mois (recommandation CNIL)
    var banner = document.getElementById('cookie-banner');

    function getChoice() {
        try {
            var choice = localStorage.getItem(KEY);
            var date = parseInt(localStorage.getItem(KEY_DATE), 10);
            if (!choice || !date || Date.now() - date > MAX_AGE) return null;
            return choice;
        } catch (e) { return null; }
    }

    function save(choice) {
        try {
            localStorage.setItem(KEY, choice);
            localStorage.setItem(KEY_DATE, String(Date.now()));
        } catch (e) {}
        banner.classList.add('d-none');
    }

    function deleteGoogleCookies() {
        document.cookie.split(';').forEach(function (c) {
            var name = c.split('=')[0].trim();
            if (name.indexOf('_ga') === 0 || name === '_gid' || name === '_gat') {
                var domain = location.hostname.replace(/^www\./, '');
                document.cookie = name + '=; Max-Age=0; path=/';
                document.cookie = name + '=; Max-Age=0; path=/; domain=.' + domain;
            }
        });
    }

    document.getElementById('cookie-accept').addEventListener('click', function () {
        save('accepted');
        window.loadGTM();
    });

    document.getElementById('cookie-refuse').addEventListener('click', function () {
        var wasAccepted = getChoice() === 'accepted';
        save('refused');
        deleteGoogleCookies();
        if (wasAccepted) location.reload(); // décharge GTM déjà actif
    });

    // Lien « Gérer les cookies » (ex. dans le footer) : <a href="#" data-cookie-settings>Gérer les cookies</a>
    document.addEventListener('click', function (e) {
        if (e.target.closest('[data-cookie-settings]')) {
            e.preventDefault();
            banner.classList.remove('d-none');
        }
    });

    if (getChoice() === null) {
        banner.classList.remove('d-none');
    }
})();
</script>
