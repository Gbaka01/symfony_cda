{# templates/partials/cookie_banner.html.twig #}
<div id="cookie-banner"
     class="position-fixed bottom-0 start-0 end-0 bg-dark text-white p-3 shadow-lg"
     style="z-index: 1080"
     role="dialog" aria-live="polite" aria-label="Consentement aux cookies"
     hidden>
    <div class="container d-flex flex-column flex-md-row align-items-md-center gap-3">
        <p class="mb-0 flex-grow-1 small">
            Nous utilisons des cookies de mesure d'audience (Google Tag Manager) uniquement avec votre accord.
            Votre choix est conservé 6 mois et modifiable à tout moment depuis les mentions légales.
        </p>
        <div class="d-flex gap-2 flex-shrink-0">
            <button type="button" class="btn btn-outline-light btn-sm" data-cookie-choice="refused">Refuser</button>
            <button type="button" class="btn btn-light btn-sm" data-cookie-choice="accepted">Accepter</button>
        </div>
    </div>
</div>

<script>
(function () {
    // Évite d'attacher les écouteurs deux fois (Turbo, double inclusion…)
    if (window.cookieBannerReady) return;
    window.cookieBannerReady = true;

    var KEY = 'cookie_consent';
    var DATE_KEY = 'cookie_consent_date';
    var MAX_AGE = 1000 * 60 * 60 * 24 * 182; // ~6 mois

    function getConsent() {
        try {
            var value = localStorage.getItem(KEY);
            var date = +localStorage.getItem(DATE_KEY);
            if (!value || !date || Date.now() - date > MAX_AGE) {
                localStorage.removeItem(KEY);
                localStorage.removeItem(DATE_KEY);
                return null;
            }
            return value;
        } catch (e) { return null; }
    }

    function setConsent(value) {
        try {
            localStorage.setItem(KEY, value);
            localStorage.setItem(DATE_KEY, String(Date.now()));
        } catch (e) {}
    }

    function banner() { return document.getElementById('cookie-banner'); }
    function show() { var b = banner(); if (b) b.hidden = false; }
    function hide() { var b = banner(); if (b) b.hidden = true; }

    // Délégation : fonctionne sur toutes les pages, même chargées par Turbo
    document.addEventListener('click', function (e) {
        var settings = e.target.closest('[data-cookie-settings]');
        if (settings) {
            e.preventDefault();
            show();
            return;
        }

        var choice = e.target.closest('[data-cookie-choice]');
        if (!choice) return;

        var value = choice.getAttribute('data-cookie-choice');
        setConsent(value);
        hide();

        if (value === 'accepted') {
            window.loadGTM();
        } else {
            gtag('consent', 'update', {
                ad_storage: 'denied',
                ad_user_data: 'denied',
                ad_personalization: 'denied',
                analytics_storage: 'denied'
            });
            // GTM déjà chargé : on recharge pour qu'il ne tourne plus
            if (window.gtmLoaded) location.reload();
        }
    });

    function init() { if (!getConsent()) show(); }
    init();
    document.addEventListener('turbo:load', init);
})();
</script>
