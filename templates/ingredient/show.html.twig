{% extends 'base.html.twig' %}

{% block title %}Ingredient{% endblock %}

{% block body %}
    <h1>Ingredient</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ ingredient.id }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ ingredient.description }}</td>
            </tr>
            <tr>
                <th>Recette</th>
       <td>
            {% if ingredient.recette %}
                {{ ingredient.recette.fiche }}
            {% else %}
                <em>Aucune recette</em>
            {% endif %}
        </td>
            </tr>
        </tbody>
    </table>

    <a class="btn btn-primary" href="{{ path('app_ingredient_index') }}" role="button">
        Retour vers l'accueil
    </a>

    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_VISITEUR') %}
        <a class="btn btn-info" href="{{ path('app_ingredient_edit', {'id': ingredient.id}) }}" role="button">
            Modifier
        </a>
    {% endif %}

    {% if is_granted('ROLE_ADMIN') %}
        {{ include('ingredient/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}
